# Copy this file to .env. Never commit real tokens or secrets.
# The dashboard and CLI load .env automatically from the repository root.

# -------------------- News research --------------------
# Optional. Leave blank to use free Google News RSS.
NEWSAPI_KEY=
# Default topic shown by the CLI/dashboard.
NEWS_QUERY=technology
# Research language sent to the source adapter.
NEWS_LANGUAGE=en
# Ignore stories older than this many hours.
NEWS_MAX_AGE_HOURS=48
# Number of independent sources required by the CLI picker.
NEWS_MINIMUM_SOURCES=1

# -------------------- Script generation --------------------
# Local Claude Code CLI model passed to `claude -p`.
SCRIPT_MODEL=opus

# -------------------- Research/browser --------------------
# Keep public RSS research enabled. Browser enrichment is opt-in.
PUBLIC_RESEARCH=1
PUBLIC_RESEARCH_BROWSER=0

# -------------------- Publishing --------------------
# Optional Meta Graph API user token. Required only for Instagram setup.
META_USER_TOKEN=
# Meta Graph API version used by the Instagram publisher.
META_API_VERSION=v26.0
# YouTube OAuth client JSON belongs at data/youtube_client_secret.json.

# -------------------- Local free TTS --------------------
# Download these open-source Piper models with `python scripts/setup_tts.py`.
ENGLISH_TTS_MODEL=data/voices/en_US-lessac-medium.onnx
HINDI_TTS_MODEL=data/voices/hi_IN-pratham-medium.onnx
TTS_MODEL_DIR=data/voices

# -------------------- Rendering --------------------
# 0 uses the FFmpeg renderer. Set to 1 after installing render dependencies.
REMOTION_RENDER=0

# -------------------- Dashboard --------------------
# Local-only bind address is fixed to 127.0.0.1 for safety.
NEWS_UI_PORT=8765
# 1 opens the dashboard automatically; 0 prints the URL only.
NEWS_UI_OPEN=1

# -------------------- Comment replies --------------------
# Fixed-keyword replies on your own posts. The reply script must still be run manually.
AUTO_REPLY_KEYWORD=link
AUTO_REPLY_TEXT=Here is the link: https://example.com
AUTO_REPLY_STATE=data/reply_state.json
