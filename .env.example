# Authenticated news source. Never commit real values.
NEWSAPI_KEY=
NEWS_QUERY=technology
NEWS_MAX_AGE_HOURS=48
NEWS_MINIMUM_SOURCES=1

# Hindi TTS (Google Cloud). GOOGLE_APPLICATION_CREDENTIALS should point to a
# local service-account file outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
HINDI_TTS_VOICE=hi-IN-Neural2-A

# Optional local English TTS.
ENGLISH_TTS_VOICE=af_heart
