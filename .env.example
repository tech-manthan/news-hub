# Authenticated news source. Never commit real values.
NEWSAPI_KEY=
NEWS_QUERY=technology
NEWS_MAX_AGE_HOURS=48
NEWS_MINIMUM_SOURCES=1
SCRIPT_MODEL=opus

# Optional public research browser fallback. RSS is used first and is free.
PUBLIC_RESEARCH=1
PUBLIC_RESEARCH_BROWSER=0

# Optional platform publishing. News research itself does not need these.
META_USER_TOKEN=
# YouTube OAuth client JSON belongs at data/youtube_client_secret.json.

# Free, open-source, local Piper TTS models. Download with:
#   python scripts/setup_tts.py
ENGLISH_TTS_MODEL=data/voices/en_US-lessac-medium.onnx
HINDI_TTS_MODEL=data/voices/hi_IN-pratham-medium.onnx
TTS_MODEL_DIR=data/voices

# Fixed-keyword replies on comments of your own posts. Disabled unless reply.py is run.
AUTO_REPLY_KEYWORD=link
AUTO_REPLY_TEXT=Here is the link: https://example.com
AUTO_REPLY_STATE=data/reply_state.json
